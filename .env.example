# =============================================================================
# MediaVault & Traffic Engine — plantilla de variables de entorno
# Copia este archivo a .env.local y rellena los valores. NUNCA commitees .env.local.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# En desarrollo local con `supabase start`, la CLI imprime estos tres valores.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="pega-aqui-la-anon-key"
# Clave de servicio: omite el RLS por completo. Solo en el servidor y en los
# workers. Si se filtra al navegador, todo el aislamiento multi-tenant cae.
SUPABASE_SERVICE_ROLE_KEY="pega-aqui-la-service-role-key"

# Cadena de conexion directa a Postgres. La usan las migraciones y los workers.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Cloudflare R2 (API compatible con S3) ---------------------------------
# En desarrollo se puede apuntar a MinIO: docker compose up minio
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="mediavault-dev"
# Con R2 real: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="http://127.0.0.1:9000"
R2_REGION="auto"
# Dominio publico del bucket para los archivos de teaser ya sanitizados.
R2_PUBLIC_BASE_URL="http://127.0.0.1:9000/mediavault-dev"

# --- Limites de subida -----------------------------------------------------
# Vigencia de cada URL prefirmada, en segundos. Corta a proposito: la URL es
# una credencial de escritura y no debe sobrevivir a la sesion de subida.
UPLOAD_PRESIGN_TTL_SECONDS="300"
# Peso maximo por archivo, en bytes (por defecto 2 GiB).
UPLOAD_MAX_BYTES_PER_FILE="2147483648"
# Cantidad maxima de archivos por enlace de subida.
UPLOAD_MAX_FILES_PER_LINK="50"

# --- Aplicacion ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Base de los enlaces cortos. Por defecto la misma app, en /l/[slug].
NEXT_PUBLIC_SHORT_LINK_BASE_URL="http://localhost:3000/l"

# Secreto para firmar los tokens de los enlaces de subida.
# Genera uno con: openssl rand -hex 32
UPLOAD_LINK_SECRET="cambia-esto-por-32-bytes-aleatorios"

# --- Motor de programacion (Hard Rule) -------------------------------------
# Valores por defecto de una organizacion nueva; cada una puede ajustarlos.
DEFAULT_ASSET_COOLDOWN_DAYS="30"
DEFAULT_OUTFIT_COOLDOWN_DAYS="7"
